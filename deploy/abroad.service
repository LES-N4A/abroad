[Unit]
Description=Abroad Flask marketplace
After=network.target

[Service]
Type=simple
User=abroad
Group=abroad
WorkingDirectory=/srv/abroad
EnvironmentFile=/srv/abroad/.env
ExecStart=/srv/abroad/.venv/bin/gunicorn \
    --workers 1 \
    --threads 4 \
    --bind 127.0.0.1:8000 \
    --access-logfile - \
    --error-logfile - \
    wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
