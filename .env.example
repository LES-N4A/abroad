# Abroad Marketplace - Environment Variables
# Copy this to .env and fill in your actual values

# Flask Configuration
SECRET_KEY=change-this-to-a-long-random-string-in-production
FLASK_ENV=production
FLASK_DEBUG=0

# Database
DATABASE_URL=postgresql://abroad_user:password@localhost:5432/abroad_production
# For development, use: sqlite:///instance/abroad.sqlite

# Redis (Caching & Sessions)
REDIS_URL=redis://localhost:6379/0

# Email Service (SendGrid)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@abroad.tn
SENDGRID_FROM_NAME=Abroad Marketplace

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# AWS (S3 for file storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=abroad-uploads
AWS_REGION=eu-west-1

# Cloudinary (Alternative to S3)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Sentry (Error Monitoring)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Application Settings
UPLOAD_FOLDER=instance/uploads
MAX_CONTENT_LENGTH=6291456  # 6MB in bytes
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf
ALLOW_DEMO_ADMIN=0  # Set to 1 only in development
SESSION_COOKIE_SECURE=1  # HTTPS only
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SAMESITE=Lax

# Escrow & Business Logic
REFUND_SWEEP_SECONDS=3600  # Run refund check every hour
RECEIPT_DEADLINE_HOURS=48
DELIVERY_CODE_EXPIRY_HOURS=24
MAX_CODE_ATTEMPTS=5

# Rate Limiting
RATE_LIMIT_ENABLED=1
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/1
RATE_LIMIT_DEFAULT=100 per hour

# Celery (Background Tasks)
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# Admin Configuration
ADMIN_EMAIL=admin@abroad.tn

# Feature Flags
ENABLE_SMS_NOTIFICATIONS=1
ENABLE_EMAIL_NOTIFICATIONS=1
ENABLE_RECEIPT_OCR=0
ENABLE_API=1

# Development Only
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
